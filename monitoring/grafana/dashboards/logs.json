{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Umami — Logs",
  "uid": "umami-logs",
  "schemaVersion": 39,
  "tags": ["umami", "logs"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Контейнер",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Объём логов (строк/интервал) по контейнерам",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"}[$__interval]))",
          "legendFormat": "{{container}}",
          "queryType": "range"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Логи контейнеров (реальные записи)",
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=~\"$container\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
