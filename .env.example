# =============================================================================
# Шаблон переменных окружения. Реальный .env генерируется setup.sh
# (случайные пароли через openssl) и НЕ коммитится (см. .gitignore).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=umami
POSTGRES_USER=umami

POSTGRES_PASSWORD=change-me-generated-by-setup

# --- Umami ---
# Секрет для подписи токенов аутентификации.
APP_SECRET=change-me-generated-by-setup

# Порт, на котором приложение доступно на хосте
APP_PORT=3000
